@page "/"
@inject State state
@inject AppLogger logger
@inject IJSRuntime JSRuntime
@inject Settings settings
@inject SessionState Ui
@implements IAsyncDisposable

<PageTitle>@Globals.APPLICATION_NAME</PageTitle>

<div style="display:flex; flex-direction:column; height:100%; min-height:0;">
    @* Buttons and status *@
    <div>
        @* Buttons*@
        @if (isSmall)
        {
            <span style="margin-right:24px;">
                <RadzenButton Click="ClearScreen"
                              Text="Clear"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="border-radius:20px; padding-top:2px; height:24px; min-height:24px;" />
            </span>
            <span style="margin-right:24px;">
                <RadzenButton Click="CancelButtonPressed"
                              Text="Cancel"
                              ButtonStyle="ButtonStyle.Danger"
                              Style="border-radius:20px; padding-top:2px; height:24px; min-height:24px;" />
            </span>
        }
        else
        {
            <span style="margin-right:24px;">
                <RadzenButton Click="ClearScreen"
                              Text="Clear screen"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="border-radius:20px;" />
            </span>
            <span style="margin-right:24px;">
                <RadzenButton Click="CancelButtonPressed"
                              Text="Cancel Playback"
                              ButtonStyle="ButtonStyle.Danger"
                              Style="border-radius:20px;" />
            </span>
        }

        @* Status *@
        <span>
            @settings.Status
        </span>
        <p />
    </div>

    @* Application log *@
    <div style="flex:1 1 auto; min-height:36px; min-width:0; margin-bottom:18px;">
        <RadzenTextArea Id="AlpacaSpyLog"
                        Style=@($"font-family: \"Lucida Console\", \"Courier New\", monospace; font-size: 14px; line-height: 18px; padding-bottom: 0px; width:100%; height:100%;font-size: {FontSize}px;")
                        Name="AlpacaSpyLog"
                        @bind-Value=@ApplicationLog
                        Cols="250"
                        ReadOnly=true />
    </div>
</div>

@code
{
    CancellationTokenSource cancelAlpacaSpy = new CancellationTokenSource();

    private bool isSmall;
    private bool _disposed;
    private bool _logContentChanged;
    private int _lastLogLength;
    private string _cachedLogText = string.Empty;
    private readonly CancellationTokenSource _cts = new();

    private int FontSize { get { if (isSmall) return 13; return 14; } }

    private string ApplicationLog { get => _cachedLogText; set { } }

    #region Lifecycle event handlers

    protected override async Task OnInitializedAsync()
    {
        // Set up the event handlers
        Ui.OnChange += OnBrowserResize;
        state.StateChanged += OnStateChanged;
        settings.ConfigurationChanged += OnStateChanged;

        // Set the application cancel token
        state.CancellationToken = cancelAlpacaSpy.Token;

        // Get any current log content and place it in the cache
        lock (Globals.writeLogLock)
        {
            _cachedLogText = state.ApplicationLog.ToString();
            _lastLogLength = state.ApplicationLog.Length;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Set up the log refresh task to update the log content when it changes
            await LogRefreshAsync(_cts.Token);

            try
            {
                // Scroll to the bottom of any log content that was already present
                await ScrollLogToBottomAsync();
            }
            catch (Exception ex)
            {
                logger.LogError("Index", $"Error scrolling to bottom of log: {ex.Message}\r\n{ex}");
            }
        }

        // If the log content has changed, scroll to the bottom of the log
        if (_logContentChanged)
        {
            _logContentChanged = false;
            await ScrollLogToBottomAsync();
        }
    }

    #endregion

    #region External event handlers

    /// <summary>
    /// Handles the browser resize event.
    /// </summary>
    private async void OnBrowserResize()
    {
        try
        {
            isSmall = Globals.IsSmall(Ui.Width, Ui.Height);
            await InvokeAsync(StateHasChanged);
            await ScrollLogToBottomAsync();
        }
        catch (Exception ex)
        {
            logger.LogError("HandleResize", $"Exception - {ex.Message}\r\n{ex}");
        }
    }

    /// <summary>
    /// Handles the state changed event.
    /// </summary>
    private async void OnStateChanged(object? sender, EventArgs e)
    {
        if (_disposed)
            return;

        await InvokeAsync(StateHasChanged);
    }

    #endregion

    #region Button handlers

    private async Task CancelButtonPressed()
    {
        cancelAlpacaSpy.Cancel();
    }

    private async Task ClearScreen()
    {
        logger.ClearScreen();
        _cachedLogText = string.Empty;
        _lastLogLength = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConnectDisconnectAsync()
    {
        try
        {
            state.OperationUnderway = true;
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
        finally
        {
            state.OperationUnderway = false;
        }
    }

    #endregion

    #region Support code

    /// <summary>
    /// Scrolls the log content to the bottom.
    /// </summary>
    private async Task ScrollLogToBottomAsync()

    {
        try
        {
            await JSRuntime.InvokeVoidAsync("ScrollToBottom", "AlpacaSpyLog");
        }
        catch (InvalidOperationException ex)
        {
            logger.LogWarning("Index", $"Log scroll is not ready: {ex.Message}");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// Refreshes the log content periodically.
    /// </summary>
    /// <param name="token">The cancellation token.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task LogRefreshAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(Globals.LOG_REFRESH_INTERVAL, token);

                int currentLength = state.ApplicationLog.Length;
                if (currentLength != _lastLogLength)
                {
                    _lastLogLength = currentLength;
                    lock (Globals.writeLogLock)
                    {
                        _cachedLogText = state.ApplicationLog.ToString();
                    }
                    _logContentChanged = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (TaskCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    #endregion

    #region IAsyncDisposable implementation
    
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        state.StateChanged -= OnStateChanged;
        settings.ConfigurationChanged -= OnStateChanged;
        Ui.OnChange -= OnBrowserResize;
    }
    
    #endregion
}
